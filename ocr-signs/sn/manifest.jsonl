{"id": "sn-5003", "file": "sn/sn-5003.jpg", "sha256": "ef66cfa66b2a1f9a0b661058fe0f39d3fc5f18fecefbf7aca1811e3748beec75", "source": "commons", "source_url": "https://commons.wikimedia.org/wiki/File:Faddiouth_sign.jpg", "author": "Madison Gray", "license": "Public domain", "license_url": "https://creativecommons.org/publicdomain/mark/1.0/", "attribution": "Photo: Madison Gray, Public domain, via Wikimedia Commons. Source: https://commons.wikimedia.org/wiki/File:Faddiouth_sign.jpg. License: https://creativecommons.org/publicdomain/mark/1.0/. Unmodified original.", "country": "SN", "region": "west-africa", "kind": "landmark", "scripts": ["Latn"], "lines": [{"text": "COMMUNE DE JOAL-FADIOUTH", "lang": "fr"}, {"text": "PAR ARRÊTÉ MUNICIPAL N°06 du 15-04-05", "lang": "fr"}], "expect": {"query": "Joal-Fadiouth", "record": "", "type": "place", "near": null, "in_map": null}, "location": null, "location_source": "", "difficulty": "medium", "notes": "Hand-painted municipal notice at the bridge to Fadiouth island. Only the header and decree line are transcribed; the remaining hand-lettered rules (no sitting on the bridge railings, no cars, no bicycles or two-wheelers in the village) mix upper and lower case irregularly and are left out. The blue 'KANE_PRODUCTION' photo-shop board behind is a distractor.", "original_url": "https://upload.wikimedia.org/wikipedia/commons/d/d1/Faddiouth_sign.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "width": 1920, "height": 1440, "derivative": "", "map_verification": "pending", "label_status": "visually transcribed", "source_title": "File:Faddiouth sign.jpg", "source_categories": ["French language in Senegal", "January 2007 in Senegal", "Joal-Fadiouth", "Signs in Senegal"]}
